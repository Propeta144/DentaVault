# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=5000
NODE_ENV=development

# MySQL (XAMPP defaults shown)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dentavault
# Production (Aiven) lang: SSL. I-paste ang CA certificate galing sa Aiven
# console (buong PEM, pwedeng may literal na \n). Iwanang blank sa local.
DB_SSL_CA=

# Production lang: ilang proxy ang nasa harap ng server (Vercel + Render = 2),
# para tama ang IP Address sa Audit Log. Iwanang blank sa local.
TRUST_PROXY=

# JWT
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=8h

# Cloudinary (leave blank for now — local disk storage is used until these are set)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Brute-force protection: ilang MALING login (bawat IP at bawat email) ang
# pinapayagan sa loob ng window bago maghintay. Ganito rin sa change password.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# Ilang X-ray ang puwedeng i-upload ng isang patient sa patient portal bawat
# 24 oras (matagumpay lang ang binibilang). Default: 10
PATIENT_XRAY_UPLOADS_PER_DAY=10

# Comma-separated origins allowed to call this API
CORS_ORIGIN=http://localhost:5173

# Audit log retention (RA 10173). Lumang entries ay inililipat sa archive
# files (JSON Lines, isa bawat buwan) bago burahin sa database. Tumatakbo
# araw-araw sa loob ng server; manual: npm run audit:prune -- --dry-run
# PLACEHOLDER ang mga araw — palitan kapag kumpirmado na ang legal na tagal.
AUDIT_RETENTION_ENABLED=true
AUDIT_RETENTION_VIEW_DAYS=365
AUDIT_RETENTION_CHANGE_DAYS=1825
AUDIT_ARCHIVE_DIR=archives/audit-logs
