# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=5000
NODE_ENV=development

# MySQL (XAMPP defaults shown)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dentavault

# JWT
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=8h

# Cloudinary (leave blank for now — local disk storage is used until these are set)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mailgun (leave blank for now — wired up once you have an account)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_WEBHOOK_SIGNING_KEY=

# Comma-separated origins allowed to call this API
CORS_ORIGIN=http://localhost:5173
